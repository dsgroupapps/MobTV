VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
PUBLIC_SIGNUP_ENABLED=false

# Server-only — NUNCA usar prefixo VITE_ (vazaria para o bundle do browser).
# Usada só pelo repository de leitura de analytics_events via Edge Function
# (src/lib/analytics/reporting/repository.ts). Não colocar o valor real aqui.
ANALYTICS_API_KEY=

# Server-only — envio do relatório de analytics por e-mail
# (src/lib/analytics/report-delivery/). RESEND_API_KEY é a mesma chave já
# usada pelo sistema de leads (src/lib/leads/point-lead.ts) — não duplicar.
# MOBTV_ANALYTICS_FROM_EMAIL tem fallback documentado para
# MOBTV_LEADS_FROM_EMAIL se ausente; MOBTV_ANALYTICS_TO_EMAIL é sempre
# próprio de analytics, sem fallback para o e-mail comercial de leads.
RESEND_API_KEY=
MOBTV_ANALYTICS_FROM_EMAIL=
MOBTV_ANALYTICS_TO_EMAIL=
