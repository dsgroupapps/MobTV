VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
PUBLIC_SIGNUP_ENABLED=false

# Server-only — e-mail de interesse/lead enviado pelo formulário das páginas
# de perfil de ponto (src/lib/leads/point-lead.ts). Sem RESEND_API_KEY e
# MOBTV_LEADS_FROM_EMAIL configuradas, o envio falha (erro tratado, o
# visitante vê uma mensagem genérica) — não há outro caminho de contato
# nessa página. MOBTV_LEADS_TO_EMAIL é opcional: sem ela, cai para
# "comercial@mobtv.tv.br" (hardcoded em point-lead.ts). Não colocar valores
# reais aqui.
RESEND_API_KEY=
MOBTV_LEADS_FROM_EMAIL=
MOBTV_LEADS_TO_EMAIL=

# Server-only — NUNCA usar prefixo VITE_ (vazaria para o bundle do browser).
# Usada só pelo repository de leitura de analytics_events via Edge Function
# (src/lib/analytics/reporting/repository.ts). Não colocar o valor real aqui.
ANALYTICS_API_KEY=

# Server-only — envio do relatório de analytics por e-mail
# (src/lib/analytics/report-delivery/). Reaproveita o mesmo RESEND_API_KEY
# acima — não duplicar. MOBTV_ANALYTICS_FROM_EMAIL tem fallback documentado
# para MOBTV_LEADS_FROM_EMAIL se ausente; MOBTV_ANALYTICS_TO_EMAIL é sempre
# próprio de analytics, sem fallback para o e-mail comercial de leads.
MOBTV_ANALYTICS_FROM_EMAIL=
MOBTV_ANALYTICS_TO_EMAIL=
